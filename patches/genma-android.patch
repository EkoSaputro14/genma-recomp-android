+void ColourBlock(const uint8_t *b, bool dxt1, uint8_t *out) {
+    uint16_t c0 = uint16_t(b[0] | (b[1] << 8)), c1 = uint16_t(b[2] | (b[3] << 8));
+    uint8_t pal[4][4] = {};
+    Rgb565(c0, pal[0]);
+    Rgb565(c1, pal[1]);
+    for (int i = 0; i < 4; i++) pal[i][3] = 255;
+    for (int k = 0; k < 3; k++) {
