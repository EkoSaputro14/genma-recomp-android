+#ifdef __ANDROID__
+bool Vulkan::RecreateSurface() {
+    Submit();
+    Check(vkQueueWaitIdle(queue_), "surface recreate idle");
+    if (swap_) {
+        vkDestroySwapchainKHR(device_, swap_, nullptr);
+        swap_ = VK_NULL_HANDLE;
+        swap_images_.clear();
+    }
+    if (surface_) {
+        vkDestroySurfaceKHR(instance_, surface_, nullptr);
+        surface_ = VK_NULL_HANDLE;
+    }
+    if (!host::Foreground()) {
+        host::WaitForeground();
+    }
+    if (!SDL_Vulkan_CreateSurface(static_cast<SDL_Window *>(app::Window()), instance_, nullptr, &surface_)) {
+        LOGW("vulkan: SDL_Vulkan_CreateSurface deferred: %s", SDL_GetError());
+        surface_lost_ = true;
+        return false;
+    }
+    extent_ = {};
+    surface_epoch_ = host::SurfaceEpoch();
+    surface_lost_ = false;
+    LOGR("vulkan: surface recreated (epoch=%u)", surface_epoch_);
+    return true;
+}
