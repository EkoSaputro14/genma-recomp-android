+void OnGamepadEvent(uint32_t event_type, uint32_t which) {
+    std::lock_guard lock(g_lock);
+    if (!g_sdl) return;
+    if (event_type == SDL_EVENT_GAMEPAD_ADDED) AddPad(SDL_JoystickID(which));
+    else if (event_type == SDL_EVENT_GAMEPAD_REMOVED) RemovePad(SDL_JoystickID(which));
+}
+
+void RefreshGamepads() {
+    std::lock_guard lock(g_lock);
+    if (!g_sdl) return;
+    for (int i = 0; i < 4; i++) {
+        if (g_pads[i] && !SDL_GamepadConnected(g_pads[i])) {
+            SDL_CloseGamepad(g_pads[i]);
+            g_pads[i] = nullptr;
+            LOGI("input: controller %d disconnected (refresh)", i + 1);
+        }
+    }
+    int count = 0;
+    if (SDL_JoystickID* ids = SDL_GetGamepads(&count)) {
+        for (int i = 0; i < count; i++) AddPad(ids[i]);
+        SDL_free(ids);
+    }
+}
